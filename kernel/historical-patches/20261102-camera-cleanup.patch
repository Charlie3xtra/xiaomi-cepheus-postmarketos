+/*
+ * SM8150/CSID175 requires the downstream global-reset preparation: keep
+ * receiver clocks active, prepare every data path, then reset hardware and
+ * software registers separately. Poll RESET_DONE with the top IRQ masked;
+ * a zero reset-strobe value is not evidence that reset has completed.
+ * See Xiaomi cepheus-p-oss cam_ife_csid_global_reset().
+ */
+static int csid_reset_8150(struct csid_device *csid)
+{
+	u32 status;
+	unsigned int i;
+	int ret;
+
+	writel(0, csid->base + CSID_TOP_IRQ_MASK);
+	writel(0, csid->base + CSID_CSI2_RX_IRQ_MASK);
+	writel(0, csid->base + 0x34); /* IPP IRQ mask */
+	writel(0, csid->base + 0xa4); /* PPP IRQ mask */
+	writel(1, csid->base + CSID_TOP_IRQ_CLEAR);
+	writel(0x0fffffff, csid->base + CSID_CSI2_RX_IRQ_CLEAR);
+	writel(0x7fff, csid->base + 0x38); /* IPP IRQ clear */
+	writel(0xffff, csid->base + 0xa8); /* PPP IRQ clear */
+	for (i = 0; i < 3; i++) {
+		writel(0, csid->base + CSID_CSI2_RDIN_IRQ_MASK(i));
+		writel(0x7fff, csid->base + CSID_CSI2_RDIN_IRQ_CLEAR(i));
+	}
+	writel(1, csid->base + CSID_IRQ_CMD);
+
+	writel(BIT(CSI2_RX_CFG1_CGC_MODE), csid->base + CSID_CSI2_RX_CFG1);
+	writel(1, csid->base + 0x200); /* IPP CFG0 */
+	writel(1, csid->base + 0x700); /* PPP CFG0 */
+	for (i = 0; i < 3; i++)
+		writel(2, csid->base + CSID_RDI_CFG0(i));
+
+	writel(0x1e, csid->base + CSID_RST_STROBES);
+	ret = readl_poll_timeout(csid->base + CSID_TOP_IRQ_STATUS,
+				 status, status & BIT(TOP_IRQ_STATUS_RESET_DONE),
+				 100, 100000);
+	if (ret) {
+		dev_err(csid->camss->dev, "CSID%u hardware reset timeout (%08x)\n",
+			csid->id, status);
+		return ret;
+	}
+
+	writel(1, csid->base + CSID_TOP_IRQ_CLEAR);
+	writel(1, csid->base + CSID_IRQ_CMD);
+	writel(1, csid->base + CSID_RST_STROBES);
+	ret = readl_poll_timeout(csid->base + CSID_TOP_IRQ_STATUS,
+				 status, status & BIT(TOP_IRQ_STATUS_RESET_DONE),
+				 100, 100000);
+	if (ret)
+		dev_err(csid->camss->dev, "CSID%u software reset timeout (%08x)\n",
+			csid->id, status);
+	writel(1, csid->base + CSID_TOP_IRQ_CLEAR);
+	writel(1, csid->base + CSID_IRQ_CMD);
+	writel(1, csid->base + CSID_TOP_IRQ_MASK);
+	return ret;
+}
