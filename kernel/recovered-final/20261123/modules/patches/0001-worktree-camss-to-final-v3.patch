+static int csid_reset_8150(struct csid_device *csid)
+{
+	int ret;
+
+	/* A pending receiver/RDI IRQ can otherwise consume RESET_DONE while
+	 * the synchronous reset polls it, even with TOP_IRQ_MASK cleared.
+	 */
+	disable_irq(csid->irq);
+	ret = __csid_reset_8150(csid);
+	enable_irq(csid->irq);
+	return ret;
