+/*
+ * CSID175 global reset alone can leave the C-PHY receiver byte FIFOs out of
+ * alignment. Reset the receiver after programming the PHY selection and lane
+ * count, before resuming RDI and before the sensor starts transmitting.
+ * Register layout and reset mask: Xiaomi cepheus-p-oss cam_ife_csid175.h.
+ */
+static void csid_reset_cphy_rx_8150(struct csid_device *csid)
+{
+	u32 status;
+	int ret;
+
+	writel(CSI2_RX_IRQ_RESET_DONE, csid->base + CSID_CSI2_RX_IRQ_CLEAR);
+	writel(1, csid->base + CSID_IRQ_CMD);
+	writel(CSI2_RX_RST_STROBES_ALL, csid->base + CSID_CSI2_RX_RST_STROBES);
+	ret = readl_poll_timeout(csid->base + CSID_CSI2_RX_IRQ_STATUS,
+				 status, status & CSI2_RX_IRQ_RESET_DONE,
+				 100, 100000);
+	if (ret)
+		dev_err(csid->camss->dev, "CSID%u C-PHY RX reset timeout (%08x)\n",
+			csid->id, status);
+	writel(CSI2_RX_IRQ_RESET_DONE, csid->base + CSID_CSI2_RX_IRQ_CLEAR);
+	writel(1, csid->base + CSID_IRQ_CMD);
